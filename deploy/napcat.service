[Unit]
Description=NapCat QQ gateway (headless)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fyshion
WorkingDirectory=/home/fyshion/Napcat
Environment=HOME=/home/fyshion
Environment=QQ_ACCOUNT=
ExecStart=/usr/bin/xvfb-run -a /home/fyshion/Napcat/opt/QQ/qq --no-sandbox --disable-gpu -q ${QQ_ACCOUNT}
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
